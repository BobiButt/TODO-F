# Backend API base URL (build-time — required)
API_BASE_URL=https://your-backend.vercel.app/api/v1

# Google OAuth client ID for "Sign in with Google" (build-time — required)
# Get this from Google Cloud Console → APIs & Services → OAuth 2.0 Client IDs.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Optional: local dev proxy target
VITE_DEV_API_TARGET=http://localhost:8000
