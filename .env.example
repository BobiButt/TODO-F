# ============================================================================
# FILE:       frontend-test/.env.example
# PURPOSE:    Safe template for the frontend build configuration.
#             Copy to .env and fill in the real values.
# NOTE:        Vite only inlines variables that start with VITE_ (or with the
#             extra prefixes configured in vite.config.ts). Both spellings
#             below work:
#               API_BASE_URL       -> injected through vite.config.ts `define`
#               VITE_API_BASE_URL  -> inlined natively by Vite
#             On Vercel, set the variable in
#             Project Settings → Environment Variables → "Build and Runtime".
# ============================================================================

# Backend API base URL (no trailing slash).
# Local development:
API_BASE_URL=http://localhost:8000/api/v1

# Production:
# API_BASE_URL=https://your-backend.vercel.app/api/v1
# VITE_API_BASE_URL=https://your-backend.vercel.app/api/v1

# Target the dev/preview server proxies /api requests to.
VITE_DEV_API_TARGET=http://localhost:8000

# Google OAuth client ID for "Sign in with Google" (Google Cloud Console).
# Replace with your real Web client ID.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
