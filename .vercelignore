# ============================================================================
# FILE:       frontend-test/.vercelignore
# PURPOSE:    Controls what Vercel uploads when this folder is deployed as a
#             standalone project (Root Directory = frontend-test).
# HOW IT WORKS: Every pattern below removes files from the deployment upload.
#             Never ignore package.json / package-lock.json — Vercel needs
#             them to install the dependencies and run the build.
# KEY CONCEPTS: upload size, build speed, dependency installation.
# ============================================================================

# --- Dependencies (re-installed by Vercel during the build) ---------------
node_modules/
.npm/

# --- Build output (produced by the build command) --------------------------
dist/
.vite/

# --- Local environment -----------------------------------------------------
# NOTE: the .env file is intentionally NOT ignored here, so an uploaded copy
# is available as a fallback. Prefer the Vercel dashboard variables instead.
.env.local
.env.*.local

# --- Logs -----------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Version control / editors --------------------------------------------
.git
.gitignore
.vscode/
.idea/
*.swp
.DS_Store
